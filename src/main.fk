import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*

// kiln: builds the fckt project whose build.fk is in this folder, or with -C, in another. First it
// reads settings.fk, in this folder, or the nearest above that lists this one in its projects:
// where libraries are looked for, what build scripts use, and which projects are built with this
// one. Then it adds a main to the build script, which hands project, with its tasks and plugins, to
// uk.m4xy.kiln's runBuild, compiles that with fckt and ocamlopt to .kiln/build, again only when it
// changes, and runs it.

version = "0.1.0"

usage = """usage: kiln [-C <dir>] <task>... [-- <args>]

Builds the fckt project whose build.fk is in this folder, or with -C, in dir: kiln build, test,
run, clean, compile, publishLocal, roots, or tasks to list them. build.fk declares project =
Project(name = "..."), and may declare tasks = [Task(...)], its own, and plugins = [...], those it
applies. settings.fk, beside it or above, declares settings = Settings(...): the repositories
libraries are looked for in, in order; what build scripts use, for their plugins; and the projects
built with the one in its folder. What follows -- goes to the tasks, as to the program for run.
FCKT says where fckt is, if the shell can't find it."""

// What a build script imports without saying: what it needs to say what its project is.
buildImports = [
  "uk.m4xy.kiln.*", "uk.m4xy.kiln.Builds.*", "uk.m4xy.kiln.Dependencies.*",
  "fckt.io.Path", "fckt.io.FileSystem", "fckt.io.Process", "fckt.io.Paths.*", "fckt.io.Files.*", "fckt.io.Processes.*",
]

// What settings.fk says, as kiln reads it, from the folder it's in: the repositories, local or a
// folder, in the order they're tried; what build scripts use, a library's coordinates or a project's
// folder; and the projects' folders. Folders are as settings.fk has them, from its own.
type Read(folder: String, repositories: List<String>, uses: List<String>, projects: List<String>)

@Console @FileSystem @Process main(args: List<String>) = {
  rest = when (args) {
    ["-C", dir, *more] -> {
      changeDirectory(dir)
      more
    }
    else -> args
  }
  code = if (rest == ["--version"]) {
    println("kiln $version")
    0
  } else if (rest == ["--help"] || rest == ["-h"]) {
    println(usage)
    0
  } else {
    build(rest)
  }
  exit(code)
}

// Runs the tasks args names, in the projects the settings here list, then on the project here, and
// gives the exit code. roots is about this project only, for another that depends on it.
@Console @FileSystem @Process build(args: List<String>): Int = {
  here = currentDirectory(Unit)
  settings = settingsFor(here)
  names = args.takeWhile(a -> a != "--")
  included = when (settings) {
    Some(read) -> if (read.folder == here && !names.contains("roots")) read.projects.map(p -> absolute(read.folder, p)) else []
    None -> []
  }
  failed = included.find(folder -> {
    println("> Project ${folder.removePrefix(here + "/")}")
    system(executable(Unit), ["-C", folder] + args) != 0
  })
  if (failed.isSome()) 1
  else if (path("build.fk").exists()) script(settings, args)
  else if (!included.isEmpty()) 0
  else {
    println("kiln: there's no build.fk here, so no project to build")
    2
  }
}

// The build script here, compiled with what the settings say it uses, run with args.
@Console @FileSystem @Process script(settings: Option<Read>, args: List<String>): Int = {
  lines = path("build.fk").readLines()
  // What the script declares, by the names its lines start with.
  declares = (name: String) -> lines.any(line -> line.startsWith("$name =") || line.startsWith("$name:"))
  if (declares("main")) {
    println("build.fk: it declares project, and kiln runs it, so it can't have a main")
    1
  } else if (!declares("project")) {
    println("build.fk: it must declare project = Project(name = \"...\")")
    1
  } else if (declares("uses") || !listed("plugins", lines).isEmpty()) {
    println("build.fk: the libraries and projects it's compiled with go in settings.fk, settings = Settings(uses = [...]); plugins = [...] applies their plugins, as modules")
    1
  } else {
    read = settings.getOrElse(Read(".", ["local"], [], []))
    given = ["tasks", "plugins"].filter(declares).map(name -> ", $name = $name").joinToString("")
    repositories = read.repositories.map(r -> if (r == "local") "Local" else "At(path(\"$r\"))").joinToString(", ")
    // The script, then its main, so the script's lines keep their numbers: its folders aren't
    // packages, as src would be if the project's folder were one of fckt's.
    program = "${lines.joinToString("\n")}\n\nmain(args: List<String>) = uk.m4xy.kiln.Builds.runBuild(project.copy(repositories = [$repositories]), args$given)\n"
    code = compileScript(program, "build.fk", path(".kiln"), [library()] + pluginRoots(read.uses, read.repositories))
    // A plugin's tasks use kiln's library, as kiln() says, from where this kiln has it.
    setEnv("KILN_LIB", library().value)
    if (code != 0) 1 else system(path(".kiln/build").value, args)
  }
}

// The settings that apply here: settings.fk here, or in the nearest folder above that has one, if
// it lists this one in its projects.
@Console @FileSystem @Process settingsFor(here: String): Option<Read> = when (nearest(path(here))) {
  None -> None
  Some(folder) -> {
    read = readSettings(folder.value)
    if (read.folder == here || read.projects.any(p -> absolute(read.folder, p) == here)) Some(read) else None
  }
}

// The nearest folder with a settings.fk: folder, or one it's in.
@FileSystem nearest(folder: Path): Option<Path> =
  if (folder.resolve("settings.fk").exists()) Some(folder)
  else when (folder.parent) {
    Some(up) -> if (up == folder) None else nearest(up)
    None -> None
  }

// What folder's settings.fk says: compiled with a main that prints it, with kiln's library alone, so
// it can't use what it says build scripts use; and run.
@Console @FileSystem @Process readSettings(folder: String): Read = {
  lines = path(folder).resolve("settings.fk").readLines()
  if (!lines.any(line -> line.startsWith("settings =") || line.startsWith("settings:"))) {
    println("settings.fk: it must declare settings = Settings(...)")
    exit(1)
  }
  program = "${lines.joinToString("\n")}\n\nmain(args: List<String>) = uk.m4xy.kiln.Builds.settingsLines(settings).forEach(line -> println(line))\n"
  cache = path(folder).resolve(".kiln/settings")
  if (compileScript(program, "settings.fk", cache, [library()]) != 0) exit(1)
  said = run(cache.resolve("build").value, [])
  if (said.code != 0) {
    print(said.value)
    exit(1)
  }
  out = said.value.split("\n").filter(line -> !line.isEmpty())
  saying = (what: String) -> out.filter(line -> line.startsWith("$what ")).map(line -> line.removePrefix("$what "))
  Read(
    folder,
    saying("repository").map(r -> if (r == "local") r else absolute(folder, r.removePrefix("at "))),
    saying("uses").map(u -> if (u.startsWith("project ")) "project " + absolute(folder, u.removePrefix("project ")) else u),
    saying("project"),
  )
}

// Compiles program, the script name with a main, to cache/build, with fckt, roots on its path, and
// ocamlopt, unless it's as it was compiled last: running the OCaml as a script would type-check all
// of it every time. Its exit code; what fckt says is wrong is the script's.
@Console @FileSystem @Process compileScript(program: String, name: String, cache: Path, roots: List<Path>): Int = {
  cache.makeDirs()
  entry = cache.resolve("main.fk")
  ml = cache.resolve("build.ml")
  built = cache.resolve("build")
  stamp = cache.resolve("stamp")
  key = "kiln $version\n$program\n${roots.flatMap(sources).map(f -> f.readText()).joinToString("\n")}"
  if (built.exists() && stamp.exists() && stamp.readText() == key) 0
  else {
    stamp.delete()
    entry.writeText(program)
    exit = run(env("FCKT").getOrElse("fckt"), [entry.value, "-o", ml.value] + roots.flatMap(root -> ["-I", root.value]) + buildImports.flatMap(i -> ["--import", i]))
    if (exit.code != 0) {
      print(exit.value.split(entry.value).joinToString(name))
      exit.code
    } else {
      native = run("ocamlopt", ["-w", "-a", "-I", "+unix", "unix.cmxa", ml.value, "-o", built.value])
      if (native.code == 0) stamp.writeText(key) else print(native.value)
      native.code
    }
  }
}

// path, from folder, if it's relative.
absolute(folder: String, path: String): String =
  if (path.startsWith("/")) path else if (path == ".") folder else "$folder/${path.removePrefix("./")}"

// Where uk.m4xy.kiln's source is: KILN_LIB; or lib/kiln beside the folder kiln is in, as it's
// installed; or, built where it's developed, its src.
@FileSystem @Process library(): Path = when (env("KILN_LIB")) {
  Some(folder) -> path(folder)
  None -> {
    home = path(executable(Unit)).parent.getOrElse(path(".")).resolve("..")
    installed = home.resolve("lib/kiln")
    if (installed.isDirectory()) installed else home.resolve("../src")
  }
}

// What name = [...] names, from where it starts to the ] that ends it: a library's coordinates,
// library("g:n:v"), or a project's folder, projectAt("../plugin"), as written; for a script written
// as kiln's once were.
listed(name: String, lines: List<String>): List<String> = {
  from = lines.dropWhile(line -> !line.startsWith("$name ="))
  open = from.takeWhile(line -> !line.contains("]"))
  text = (open + from.drop(open.size).take(1)).joinToString("\n")
  named = (call: String) -> text.split("$call(\"").drop(1).map(part -> "$call:" + part.split("\"").firstOrNone().getOrElse(""))
  named("library") + named("projectAt")
}

// Where what build scripts use has its packages: a library's source, from the first of
// repositories that has it, with the libraries it uses; a project's src.
@Console @FileSystem @Process pluginRoots(uses: List<String>, repositories: List<String>): List<Path> = uses.flatMap(u ->
  if (u.startsWith("project ")) [path(u.removePrefix("project ")).resolve("src")]
  else librarySources(u.removePrefix("library "), [], repositories)
).distinct()

@Console @FileSystem @Process librarySources(coordinates: String, seen: List<String>, repositories: List<String>): List<Path> = when (coordinates.split(":")) {
  [group, name, version] -> if (seen.contains(coordinates)) [] else {
    folders = repositories.map(r -> if (r == "local") repository() else path(r))
    when (folders.map(f -> f.resolve("$group/$name/$version")).find(f -> f.isDirectory())) {
      Some(folder) -> {
        uses = folder.resolve("dependencies")
        [folder.resolve("src")] + (if (uses.exists()) uses.readLines().filter(l -> !l.isBlank()) else []).flatMap(l -> librarySources(l.trim(), seen + [coordinates], repositories))
      }
      None -> {
        println("settings.fk: it uses $coordinates, which isn't in ${folders.map(f -> f.value).joinToString(" or ")}: run kiln publishLocal in its project")
        exit(1)
      }
    }
  }
  else -> {
    println("settings.fk: what it uses is library(\"group:name:version\") or projectAt(\"folder\"), not $coordinates")
    exit(1)
  }
}

// Where published libraries are: KILN_REPOSITORY, or ~/.kiln/repository.
@Process repository(): Path = path(env("KILN_REPOSITORY").getOrElse(env("HOME").getOrElse(".") + "/.kiln/repository"))

// The .fk files in folder and those in it.
@FileSystem sources(folder: Path): List<Path> =
  if (!folder.isDirectory()) []
  else folder.listFiles().flatMap(f -> if (f.isDirectory()) sources(f) else if (f.extension == "fk") [f] else [])

private external executable(u: Unit): String = "(fun _ -> Sys.executable_name) u"
private external currentDirectory(u: Unit): String = "(fun _ -> Sys.getcwd ()) u"
private @FileSystem external changeDirectory(dir: String): Unit = "Sys.chdir dir"
// Runs command with args, with the terminal kiln has, and gives its exit code.
private @Process external system(command: String, args: List<String>): Int = "(fun c a -> Sys.command (Filename.quote_command c a)) command args"
private @Process external exit(code: Int): Nothing = "exit code"
private @Process external setEnv(name: String, value: String): Unit = "Unix.putenv name value"
