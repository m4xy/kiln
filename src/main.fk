import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import uk.m4xy.kiln.launch.Launch
import uk.m4xy.kiln.launch.NewProjects
import uk.m4xy.kiln.launch.version

// kiln: builds the project whose build.fk is in this folder, or with -C, in another, as Launch
// does.

usage = """usage: kiln [-C <dir>] [--quiet] <task>... [-- <args>]
       kiln new <name> [--library <group>]

Builds the project whose build.fk is in this folder, or with -C, in dir: kiln clean, check, build,
the tasks its plugins make, or tasks to list them. build.fk, which is fckt, declares project =
Project(name = "..."), and may declare tasks = [Task(...)], its own, and plugins = [...], those it
applies: plugins = [Fckt()] builds fckt, with compile, run, publishLocal and roots. With --quiet,
only what the tasks print is printed, for this project alone. settings.fk, beside it or above, declares settings = Settings(...): the repositories
libraries are looked for in, in order; what build scripts use, for their plugins; and the projects
built with the one in its folder. What follows -- goes to the tasks, as to the program for run.
kiln new makes a project to start from, in a folder of that name: a program, or with
--library, a library whose packages are under the group. FCKT says where fckt is, if the shell
can't find it."""

@Console @FileSystem @Process main(args: List<String>) = {
  rest = when (args) {
    ["-C", dir, *more] -> {
      changeDirectory(path(dir))
      more
    }
    else -> args
  }
  code = if (rest == ["--version"]) {
    println("kiln $version")
    0
  } else if (rest == ["--help"] || rest == ["-h"]) {
    println(usage)
    0
  } else if (rest.firstOrNone() == Some("new")) {
    NewProjects.make(rest.drop(1))
  } else {
    Launch.start(rest)
  }
  exit(code)
}
