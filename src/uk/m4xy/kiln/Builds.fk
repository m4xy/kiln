import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Channels.*
import fckt.io.Processes.*
import fckt.io.Process
import fckt.io.FileSystem
import uk.m4xy.kiln.Dependencies.*
import uk.m4xy.kiln.Compiling.*

// Building a project: its tasks, and running them. kiln build, run in the folder of a build.fk,
// calls runBuild(project, args) with what follows it on the command line.
module Builds {
  // The tasks every project has.
  standardTasks: List<Task> = [
    Task("clean", "Deletes what's been built", action = project -> project.output.delete()),
    Task("compile", "Compiles the program to output/bin", action = compile),
    Task("test", "Compiles and runs each test", action = test),
    Task("build", "Compiles and tests", dependsOn = ["compile", "test"], action = project -> Unit),
    Task("run", "Runs the program, with what follows --", dependsOn = ["compile"], action = project -> Unit),
    Task("publishLocal", "Compiles and tests, then publishes it as a library to ~/.kiln/repository", dependsOn = ["compile", "test"], action = publishLocal),
    Task("roots", "Prints the folders its packages and its folder projects' are in, and the libraries it uses", action = project -> Unit),
  ]

  // Runs the tasks args name, each after those it depends on, and once; what follows -- is the
  // program's, for run. tasks lists them.
  @Building runBuild(project: Project, args: List<String>, tasks: List<Task> = standardTasks): Unit = {
    names = args.takeWhile(a -> a != "--")
    programArgs = args.dropWhile(a -> a != "--").drop(1)
    result = attempt {
      // Only these, for another project that depends on this one.
      if (names == ["roots"]) {
        resolved = resolve(project)
        resolved.roots.forEach(root -> println(root.value))
        resolved.libraries.forEach(lib -> println("library ${coordinatesText(lib)}"))
      }
      else if (names.isEmpty() || names.contains("tasks")) listTasks(project, tasks)
      else {
        order(names, tasks, []).forEach(task -> {
          println("> Task :${task.name}")
          action = task.action
          if (task.name == "run") runProgram(project, programArgs)
          else if (task.name == "test") runTests(project, programArgs)
          else action(project)
        })
        println("BUILD SUCCESSFUL")
      }
    }
    when (result) {
      Ok(_) -> Unit
      Error(reason) -> fail("BUILD FAILED: $reason")
    }
  }

  @Console private listTasks(project: Project, tasks: List<Task>): Unit = {
    println("Tasks of ${project.name} ${project.version}:")
    tasks.forEach(task -> println("  ${task.name} - ${task.description}"))
  }

  // The tasks to run for names, in order: each after what it depends on, once.
  @Fail private order(names: List<String>, tasks: List<Task>, done: List<Task>): List<Task> = when (names) {
    [] -> done
    [name, *rest] -> {
      task = when (tasks.find(t -> t.name == name)) {
        Some(found) -> found
        None -> fail("there's no task '$name'; kiln tasks lists them")
      }
      before = if (done.contains(task)) done else order(task.dependsOn, tasks, done)
      order(rest, tasks, if (before.contains(task)) before else before + [task])
    }
  }

  // file.fk to OCaml, with its packages in roots, then to a program at program, linked with what
  // linking has compiled; unless it's up to date, compiled from inputs, a digest of what it's
  // compiled from. Whether it was compiled.
  @Building private build(project: Project, program: Path, inputs: String, compile: @Building (Path) -> Unit): Boolean = {
    ocaml = project.output.resolve("ocaml")
    stamp = ocaml.resolve(program.name + ".inputs")
    if (program.exists() && stamp.exists() && stamp.readText() == inputs) false
    else {
      ocaml.makeDirs()
      stamp.delete()
      when (program.parent) {
        Some(dir) -> dir.makeDirs()
        None -> Unit
      }
      compile(ocaml.resolve(program.name + ".ml"))
      stamp.writeText(inputs)
      true
    }
  }

  // A library has no main: its packages are compiled as a library is, which checks all of them and
  // that what it shows says its types; to output/library, its interface and its OCaml.
  @Building private compile(project: Project): Unit = {
    resolved = resolve(project)
    linking = linking(resolved)
    remember(resolved, linking)
    inputs = inputs(linking, resolved.roots, if (project.main.exists()) [project.main] else [])
    if (project.main.exists()) {
      program = project.output.resolve("bin").resolve(project.name)
      if (!build(project, program, inputs, ml -> compileProgram(linking, resolved.roots, project.main, ml, program))) println("  up to date")
    } else {
      packages = project.sources.flatMap(root -> packagesIn(root, root)).distinct()
      if (packages.isEmpty()) fail("there's no ${project.main.value}, and no packages in ${project.sources.map(s -> s.value).joinToString(", ")}")
      library = project.output.resolve("library")
      stamp = library.resolve("inputs")
      if (stamp.exists() && stamp.readText() == inputs) println("  up to date")
      else {
        library.delete()
        library.makeDirs()
        unit = unitOf(if (project.group.isEmpty()) "project" else project.group, project.name)
        compilePackages(linking, resolved.roots, packages, unit, library.resolve("$unit.ml"), library.resolve("interface"))
        stamp.writeText(inputs)
        println("  checked ${packages.size} package${if (packages.size == 1) "" else "s"}: ${packages.joinToString(", ")}")
      }
    }
  }

  @Building private test(project: Project): Unit = runTests(project, [])

  // The tests: the functions marked @Test in the test folder's files, run by one program, which
  // args, from after --, choose among; and each file there with a main, a program of its own. The
  // other files are what they share. What passed, and would be compiled from what it was, isn't
  // run again.
  @Building private runTests(project: Project, args: List<String>): Unit = {
    files = if (project.tests.isDirectory()) project.tests.listFiles().filter(f -> f.extension == "fk") else []
    programs = files.filter(f -> hasMain(f))
    marked = files.any(f -> !hasMain(f) && hasTests(f))
    if (programs.isEmpty() && !marked) println("  no tests in ${project.tests.value}")
    any = marked || !programs.isEmpty()
    resolved = if (any) resolveTests(project) else Resolved([], [])
    linking = if (any) linking(resolved) else Linking(project.output, [])
    if (any) rememberTests(project, linking)
    shared = if (any) inputs(linking, resolved.roots + [project.tests], []) else ""
    tests = project.output.resolve("tests")
    // The functions marked @Test, whose runner says how each went; chosen ones are always run.
    suiteFailed = if (!marked) false else {
      program = tests.resolve("tests")
      passed = tests.resolve("tests.passed")
      if (args.isEmpty() && passed.exists() && passed.readText() == shared && program.exists()) {
        println("  ${tests.resolve("tests.summary").readText()} (up to date)")
        false
      } else {
        passed.delete()
        build(project, program, shared, ml -> compileTests(linking, resolved.roots, project.tests, project.testRunner, ml, program))
        exit = run(program.value, args)
        lines = exit.value.trim().split("\n")
        lines.forEach(line -> println("  $line"))
        if (exit.code == 0 && args.isEmpty()) {
          tests.resolve("tests.summary").writeText(lines.lastOrNull().getOrElse(""))
          passed.writeText(shared)
        }
        exit.code != 0
      }
    }
    failed = programs.filter(file -> {
      program = tests.resolve(file.nameWithoutExtension)
      passed = tests.resolve(file.nameWithoutExtension + ".passed")
      if (passed.exists() && passed.readText() == shared && program.exists()) {
        println("  passed ${file.name} (up to date)")
        false
      } else {
        passed.delete()
        build(project, program, shared, ml -> compileProgram(linking, resolved.roots, file, ml, program))
        exit = run(program.value, [])
        if (exit.code == 0) {
          passed.writeText(shared)
          println("  passed ${file.name}")
        } else {
          println("  FAILED ${file.name}\n${exit.value.trim()}")
        }
        exit.code != 0
      }
    })
    if (suiteFailed && failed.isEmpty()) fail("tests failed")
    if (suiteFailed) fail("tests failed, and ${failed.size} of ${programs.size} test programs")
    if (!failed.isEmpty()) fail("${failed.size} of ${programs.size} tests failed")
  }

  // Copies the packages under the group's folder, and what it depends on, to the repository:
  // group/name/version, with src and a dependencies file.
  @Building private publishLocal(project: Project): Unit = {
    if (project.group.isEmpty()) fail("a library needs a group, which its packages go under: Project(group = \"uk.m4xy\", ...)")
    project.dependencies.forEach(d -> when (d) {
      Folder(folder) -> fail("a published library can't use a project from a folder, ${folder.value}: publish that one too, and use it as a library")
      Library(_) -> Unit
    })
    coordinates = Coordinates(project.group, project.name, project.version)
    target = folderOf(coordinates)
    groupPath = project.group.split(".").joinToString("/")
    // Its packages are all its group's, so they never meet another library's.
    project.sources.flatMap(root -> packagesIn(root, root)).forEach(p -> {
      if (p != project.group && !p.startsWith("${project.group}.")) fail("package $p isn't under ${project.group}, the group's, so it can't be published: move it to ${groupPath}/")
    })
    project.sources.forEach(root -> {
      if (!root.resolve(groupPath).isDirectory()) fail("a library's packages go in a folder for its group, ${root.resolve(groupPath).value}")
    })
    // Only once it's sure to work, what was published as this version goes.
    target.delete()
    project.sources.forEach(root -> root.resolve(groupPath).copyRecursively(target.resolve("src").resolve(groupPath)))
    target.resolve("dependencies").writeText(project.dependencies.flatMap(d -> when (d) {
      Library(lib) -> ["${coordinatesText(lib)}\n"]
      Folder(_) -> []
    }).joinToString(""))
    println("  published ${coordinatesText(coordinates)} to ${target.value}")
  }

  // For editors, in .kiln/paths: the folders the project's packages are in, a line each, and the
  // interfaces of the libraries it uses, as compiled, so they can check its files as kiln does.
  @FileSystem private remember(resolved: Resolved, linking: Linking): Unit = {
    folder = path(".kiln")
    folder.makeDirs()
    folder.resolve("paths").writeText((resolved.roots.map(root -> "source ${root.value}\n") +
      linking.libraries.map(lib -> "library ${lib.folder.resolve("interface").value}\n")).joinToString(""))
  }

  // The tests' libraries, for editors, in .kiln/test-paths: the tests' folder, then each
  // library's interface, as .kiln/paths has the project's.
  @FileSystem private rememberTests(project: Project, linking: Linking): Unit = {
    folder = path(".kiln")
    folder.makeDirs()
    folder.resolve("test-paths").writeText((["tests ${project.tests.value}\n"] +
      linking.libraries.map(lib -> "library ${lib.folder.resolve("interface").value}\n")).joinToString(""))
  }

  // Whether the file marks a function @Test, on a line of its own.
  @FileSystem private hasTests(file: Path): Boolean = file.readLines().any(line -> line.startsWith("@Test "))

  // Whether the file declares main, on a line of its own, maybe after its effects: @Console main(...).
  @FileSystem private hasMain(file: Path): Boolean =
    file.readLines().any(line -> line.startsWith("main(") || (line.startsWith("@") && line.contains(" main(")))

  @Building private runProgram(project: Project, args: List<String>): Unit = {
    program = project.output.resolve("bin").resolve(project.name)
    exit = streaming(program.value, args) { forEachLine(line -> println(line)) }
    if (exit.code != 0) fail("${project.name} exited with ${exit.code}")
  }
}
