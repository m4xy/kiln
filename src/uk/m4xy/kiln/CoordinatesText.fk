import fckt.text.Format

// A library's coordinates as text, group:name:version, as uk.m4xy:json:1.2.0.
module CoordinatesText : Format {
  type T = Coordinates

  of(value: Coordinates): String = "${value.group}:${value.name}:${value.version}"

  read(text: String): Result<Coordinates, String> = when (text.split(":")) {
    [group, name, version] -> Ok(Coordinates(group, name, version))
    else -> Error("a library is group:name:version, as uk.m4xy:json:1.2.0, not $text")
  }
}
