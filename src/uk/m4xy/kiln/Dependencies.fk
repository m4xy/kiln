import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import fckt.io.Process
import fckt.io.FileSystem
import fckt.effects.Fail

// What a project depends on, and where their packages are.
module Dependencies {
  // A library from the local repository, as group:name:version: library("uk.m4xy:json:1.2.0");
  // or, with git, from a git repository when the local repository hasn't got it: from ref, a
  // branch, tag or commit, v and the version if it doesn't say, and the project in folder of it.
  library(
    coordinates: String,
    git: String = "",
    ref: String = "",
    folder: String = ".",
  ): Dependency =
    when (CoordinatesText.read(coordinates)) {
      Ok(lib) ->
        if (git.isEmpty()) Library(lib)
        else Git(lib, GitSource(git, if (ref.isEmpty()) "v${lib.version}" else ref, folder))
      Error(problem) -> error(problem)
    }

  // Another project, from its folder: its packages as they are, with what it depends on.
  projectAt(folder: String): Dependency = Folder(path(folder))

  // kiln's own library, uk.m4xy.kiln, for a plugin: what it makes tasks with. kiln has it, so it's
  // never published with the plugin.
  kiln(): Dependency = Kiln

  // Where kiln's library is: KILN_LIB, which kiln sets for a build script.
  @Process internal kilnLibrary(): Path = when (env("KILN_LIB")) {
    Some(folder) -> path(folder)
    None -> fail(
      "KILN_LIB doesn't say where kiln's library is; kiln sets it when it runs a build script",
    )
  }


  // Where publishLocal puts libraries: ~/.kiln/repository, or KILN_REPOSITORY if it's set.
  @Process repository(): Path = when (env("KILN_REPOSITORY")) {
    Some(folder) -> path(folder)
    None -> path(env("HOME").getOrElse(".")).resolve(".kiln/repository")
  }

  // Where publishLocal puts lib: its folder in the local repository, group/name/version.
  @Process internal publishedAt(lib: Coordinates): Path = repository().resolve(within(lib))

  // Where lib is: its folder in the first of repositories that has it.
  @FileSystem @Process internal folderOf(
    lib: Coordinates,
    repositories: List<Repository>,
  ): Option<Path> =
    repositories.map { folderIn(it).resolve(within(lib)) }.find { it.isDirectory() }

  // The folder a repository is.
  @Process internal folderIn(source: Repository): Path = when (source) {
    Local -> repository()
    At(folder) -> folder
  }

  private within(lib: Coordinates): String = "${lib.group}/${lib.name}/${lib.version}"

  // The libraries asked for, with theirs, as the repositories say, those from git fetched first.
  @Building libraries(
    wanted: List<Dependency>,
    found: List<Coordinates>,
    repositories: List<Repository>,
  ): List<Coordinates> = when (wanted) {
    [] -> found
    [Library(lib), *rest] ->
      if (found.contains(lib)) libraries(rest, found, repositories)
      else {
        if (folderOf(lib, repositories).isNone()) {
          fail(
            "there's no ${CoordinatesText.of(lib)} in ${repositories.map { folderIn(it).value }.joinToString(" or ")}: run kiln publishLocal in its project",
          )
        }
        libraries(rest + published(lib, repositories), found + [lib], repositories)
      }
    [Git(lib, source), *rest] -> {
      fetched(lib, source, repositories)
      libraries([Library(lib)] + rest, found, repositories)
    }
    [Folder(_), *rest] -> libraries(rest, found, repositories)
    [Kiln, *rest] -> libraries(rest, found, repositories)
  }

  // What a published library depends on: its dependencies file, a library's coordinates a line.
  @FileSystem @Process internal published(
    lib: Coordinates,
    repositories: List<Repository>,
  ): List<Dependency> = when (folderOf(lib, repositories)) {
    Some(folder) -> {
      file = folder.resolve("dependencies")
      if (file.exists()) file.readLines().filter { !it.isBlank() }.map { library(it.trim()) } else []
    }
    None -> []
  }

  // lib, as source says, from git, published with kiln publishLocal, which fetches what it uses
  // the same way; unless one of repositories has it already.
  @Building internal fetched(
    lib: Coordinates,
    source: GitSource,
    repositories: List<Repository>,
  ): Unit = {
    target = publishedAt(lib)
    target.parent.forEach { it.makeDirs() }
    Locks.once(target.value + ".fetching", () -> folderOf(lib, repositories).isSome()) {
      args = ["-c", script, "sh", source.url, source.ref, source.folder, kilnProgram()]
      failed = "couldn't publish ${CoordinatesText.of(lib)} from ${source.url} at ${source.ref}"
      // Run --quiet, for another program to read, what it prints is said only if it fails.
      if (env("KILN_QUIET").isSome()) {
        exit = run("sh", args)
        if (exit.code != 0) fail("$failed:\n${exit.value.trim()}")
      }
      else if (runAttached("sh", args) != 0) fail(failed)
      if (folderOf(lib, repositories).isNone()) fail(
        "${source.url} at ${source.ref} doesn't publish ${CoordinatesText.of(lib)}${if (source.folder == ".") "" else " from ${source.folder}"}",
      )
    }
  }

  @Process private kilnProgram(): String = env("KILN").getOrElse("kiln")

  // Fetches the ref alone, published from a folder that's gone after; all it prints goes where
  // errors go, so what kiln prints for another program to read is as it was.
  private script = "set -e; exec 1>&2; at=\$(mktemp -d); trap 'rm -rf \"\$at\"' EXIT; echo \"  fetching \$1 at \$2\"; git -C \"\$at\" init -q; git -C \"\$at\" fetch -q --depth 1 \"\$1\" \"\$2\"; git -C \"\$at\" -c advice.detachedHead=false checkout -q FETCH_HEAD; unset KILN_SETTINGS; \"\$4\" -C \"\$at/\$3\" publishLocal"

  // Of each library, the highest version asked for.
  chosen(libs: List<Coordinates>): List<Coordinates> =
    libs.filter { lib -> !libs.any { other -> other.group == lib.group && other.name == lib.name && newer(other.version, lib.version) } }
      .distinct()

  // Whether version a comes after b: 1.10.0 after 1.9.2.
  internal newer(
    a: String,
    b: String,
  ): Boolean = compareVersions(
    a.split(".").map { it.toIntOrNone().getOrElse(0) },
    b.split(".").map { it.toIntOrNone().getOrElse(0) },
  ) > 0

  private compareVersions(a: List<Int>, b: List<Int>): Int = when (a, b) {
    ([], []) -> 0
    ([], _) -> compareVersions([0], b)
    (_, []) -> compareVersions(a, [0])
    ([x, *xs], [y, *ys]) -> if (x != y) x - y else compareVersions(xs, ys)
  }
}
