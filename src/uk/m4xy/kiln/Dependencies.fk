import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import fckt.io.Process
import fckt.io.FileSystem

// What a project depends on, and where their packages are.
module Dependencies {
  // A library from the local repository, as group:name:version: library("uk.m4xy:json:1.2.0").
  library(coordinates: String): Dependency = when (coordinates.split(":")) {
    [group, name, version] -> Library(Coordinates(group, name, version))
    else -> error("a library is group:name:version, as uk.m4xy:json:1.2.0, not $coordinates")
  }

  // Another project, from its folder: its packages as they are, with what it depends on.
  projectAt(folder: String): Dependency = Folder(path(folder))

  // group:name:version.
  coordinatesText(lib: Coordinates): String = "${lib.group}:${lib.name}:${lib.version}"

  // Where publishLocal puts libraries: ~/.kiln/repository, or KILN_REPOSITORY if it's set.
  @Process repository(): Path = when (env("KILN_REPOSITORY")) {
    Some(folder) -> path(folder)
    None -> path(env("HOME").getOrElse(".")).resolve(".kiln/repository")
  }

  // A library's folder in the repository: group/name/version.
  @Process folderOf(lib: Coordinates): Path = repository().resolve("${lib.group}/${lib.name}/${lib.version}")

  // What the project's programs are built from: the folders its packages are in, then its folder
  // projects', each once; and the libraries it uses, with theirs and its folder projects'. Where two
  // ask for a library in different versions, the higher is used.
  @FileSystem @Process resolve(project: Project): Resolved = {
    found = folders(project.dependencies).map(folder -> folderResolved(folder))
    Resolved(
      (project.sources + found.flatMap(r -> r.roots)).distinct(),
      chosen(libraries(project.dependencies, []) + found.flatMap(r -> r.libraries)),
    )
  }

  // What the project's tests are built from: what its programs are, its test dependencies, and,
  // with runner, what runs its functions marked @Test.
  @FileSystem @Process resolveTests(project: Project, runner: Boolean): Resolved =
    resolve(project.copy(dependencies = project.dependencies + project.testDependencies + if (runner) [project.testRunner.uses] else []))

  // The libraries asked for, with theirs, as the repository says.
  @FileSystem @Process private libraries(wanted: List<Dependency>, found: List<Coordinates>): List<Coordinates> = when (wanted) {
    [] -> found
    [Library(lib), *rest] ->
      if (found.contains(lib)) libraries(rest, found)
      else {
        if (!folderOf(lib).isDirectory()) fail("there's no ${coordinatesText(lib)} in ${repository().value}: run kiln publishLocal in its project")
        libraries(rest + published(lib), found + [lib])
      }
    [Folder(_), *rest] -> libraries(rest, found)
  }

  // What a published library depends on: its dependencies file, a library's coordinates a line.
  @FileSystem @Process published(lib: Coordinates): List<Dependency> = {
    file = folderOf(lib).resolve("dependencies")
    if (file.exists()) file.readLines().filter(line -> !line.isBlank()).map(line -> library(line.trim())) else []
  }

  // Of each library, the highest version asked for.
  private chosen(libs: List<Coordinates>): List<Coordinates> =
    libs.filter(lib -> !libs.any(other -> other.group == lib.group && other.name == lib.name && newer(other.version, lib.version)))
      .distinct()

  // Whether version a comes after b: 1.10.0 after 1.9.2.
  newer(a: String, b: String): Boolean = compareVersions(a.split(".").map(n -> n.toIntOrNone().getOrElse(0)), b.split(".").map(n -> n.toIntOrNone().getOrElse(0))) > 0

  private compareVersions(a: List<Int>, b: List<Int>): Int = when (a, b) {
    ([], []) -> 0
    ([], _) -> compareVersions([0], b)
    (_, []) -> compareVersions(a, [0])
    ([x, *xs], [y, *ys]) -> if (x != y) x - y else compareVersions(xs, ys)
  }

  private folders(dependencies: List<Dependency>): List<Path> = dependencies.flatMap(d -> when (d) {
    Folder(path) -> [path]
    Library(_) -> []
  })

  // A project's folders and libraries, as its own build says: kiln -C folder roots, which prints a
  // folder a line, and a library as library and its coordinates.
  @FileSystem @Process private folderResolved(folder: Path): Resolved = {
    if (!folder.resolve("build.fk").exists()) fail("${folder.value} has no build.fk, so it isn't a project")
    exit = run(env("KILN").getOrElse("kiln"), ["-C", folder.value, "roots"])
    if (exit.code != 0) fail("couldn't read the project in ${folder.value}: ${exit.value.trim().removePrefix("BUILD FAILED: ")}")
    lines = exit.value.split("\n").map(line -> line.trim()).filter(line -> !line.isEmpty())
    Resolved(
      lines.filter(line -> !line.startsWith("library ")).map(line -> folder.resolve(line)),
      lines.filter(line -> line.startsWith("library ")).flatMap(line -> when (library(line.removePrefix("library "))) {
        Library(lib) -> [lib]
        Folder(_) -> []
      }),
    )
  }
}
