import fckt.io.Paths.*
import fckt.text.Format

// What a project uses, as text: library and its coordinates, project and its folder, as written,
// or kiln.
module DependencyText : Format {
  type T = Dependency

  of(value: Dependency): String = when (value) {
    Library(lib) -> "library ${CoordinatesText.of(lib)}"
    Folder(folder) -> "project ${folder.value}"
    Kiln -> "kiln"
  }

  read(text: String): Result<Dependency, String> =
    if (text == "kiln") Ok(Kiln)
    else if (text.startsWith("project ")) Ok(Folder(path(text.removePrefix("project "))))
    else if (text.startsWith("library ")) CoordinatesText.read(text.removePrefix("library ")).map { Library(it) }
    else Error("what's used is a library, a project or kiln, not $text")
}
