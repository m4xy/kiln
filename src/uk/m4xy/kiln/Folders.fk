import fckt.io.Path
import fckt.io.Paths.*

// What's written in settings.fk, or read from what another project says, has its folders as
// written, which may be relative to where that is: each made whole from folder, that place, as
// ../team from /work/shop is /work/team.
module Folders {
  Repository.from(folder: Path): Repository = when (this) {
    Local -> Local
    At(at) -> At(folder.resolve(at.value))
  }

  Dependency.from(folder: Path): Dependency = when (this) {
    Folder(at) -> Folder(folder.resolve(at.value))
    else -> this
  }

  Settings.from(folder: Path): Settings = Settings(
    repositories = this.repositories.map { it.from(folder) },
    uses = this.uses.map { it.from(folder) },
    projects = this.projects.map { folder.resolve(it.value) },
  )
}
