import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.FileSystem
import fckt.effects.Fail
import fckt.effects.Failure.attempt

// What kiln does once while other kilns running at the same time wait for it, rather than each doing
// it again: a lock is a folder, with the process that holds it's id in it.
internal module Locks {
  // make, by the one kiln holding lock, unless ready says what it makes is there already.
  @Building once(lock: String, ready: @FileSystem () -> Boolean, make: @Building () -> Unit): Unit =
    if (!ready()) {
      if (locked(lock)) {
        made = attempt { make() }
        unlocked(lock)
        when (made) {
          Ok(_) -> Unit
          Error(reason) -> fail(reason)
        }
      }
      else {
        awaited(lock, ready)
        once(lock, ready, make)
      }
    }

  // Waits until what lock is held for is ready, or lock's let go, as the kiln that holds it has ended.
  @FileSystem private awaited(lock: String, ready: @FileSystem () -> Boolean): Unit =
    if (ready() || !path(lock).exists()) Unit
    else if (abandoned(lock)) unlocked(lock)
    else {
      pause(0.05)
      awaited(lock, ready)
    }

  private external locked(lock: String): Boolean =
    "(fun p -> try Sys.mkdir p 0o755; let oc = open_out (Filename.concat p \"pid\") in output_string oc (string_of_int (Unix.getpid ())); close_out oc; true with Sys_error _ -> false) lock"

  private external unlocked(lock: String): Unit =
    "(fun p -> (try Sys.remove (Filename.concat p \"pid\") with Sys_error _ -> ()); try Sys.rmdir p with Sys_error _ -> ()) lock"

  // Whether the process that holds lock has ended without letting it go.
  private external abandoned(lock: String): Boolean =
    "(fun p -> try let ic = open_in (Filename.concat p \"pid\") in let pid = int_of_string (input_line ic) in close_in ic; (try Unix.kill pid 0; false with Unix.Unix_error (Unix.ESRCH, _, _) -> true) with _ -> false) lock"

  private external pause(seconds: Float): Unit = "Unix.sleepf seconds"
}
