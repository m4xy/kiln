import fckt.io.Path
import fckt.io.Paths.*

// What a project is: its name and version, where its code is, and what it uses. A build.fk at the
// project's root makes one, project = Project(name = "shop"), and kiln build, test or run builds it.
type Project(
  name: String,
  version: String = "0.1.0",
  // Who publishes it, as a reversed domain: uk.m4xy. A library's packages go in a folder of that
  // name, src/uk/m4xy, so two libraries' never meet.
  group: String = "",
  // The libraries and projects it uses: library("uk.m4xy:json:1.2.0"), projectAt("../pricing").
  dependencies: List<Dependency> = [],
  // The program's file, with its main.
  main: Path = path("src/main.fk"),
  // The folders its packages are in.
  sources: List<Path> = [path("src")],
  // Where what's built goes: the program is output/bin/name.
  output: Path = path("build"),
)
