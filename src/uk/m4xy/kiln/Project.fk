import fckt.io.Path
import fckt.io.Paths.*

// What a project is: its name and version, and what it uses. A build.fk at the project's root makes
// one, project = Project(name = "shop"), and its plugins say what it's built from and how: what
// language it's in is theirs to know, as plugins = [Fckt()] knows fckt.
type Project(
  name: String,
  version: String = "0.1.0",
  // Who publishes it, as a reversed domain: uk.m4xy.
  group: String = "",
  // The libraries and projects it uses: library("uk.m4xy:json:1.2.0"), projectAt("../pricing").
  dependencies: List<Dependency> = [],
  // Where what's built goes.
  output: Path = path("build"),
  // Where its libraries are looked for, in order; kiln sets it from settings.fk.
  repositories: List<Repository> = [Local],
)
