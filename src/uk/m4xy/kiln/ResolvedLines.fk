import fckt.io.Path
import fckt.io.Paths.*

// What a project is built from as it passes to another that depends on it, which runs kiln roots in
// its folder and reads what it prints: a line each, as of writes them, which read reads back.
internal module ResolvedLines {
  // A line for each folder its packages are in, then each library it uses.
  of(resolved: Resolved): List<String> =
    resolved.roots.map { root -> "root ${root.value}" } + resolved.libraries.map { lib -> "library ${CoordinatesText.of(lib)}" }

  // What lines say, with each folder from folder, the project's.
  read(lines: List<String>, folder: Path): Result<Resolved, String> =
    lines.filter { it.isNotBlank() }.foldResult(Resolved([], [])) { resolved, line -> withLine(resolved, line.trim(), folder) }

  private withLine(resolved: Resolved, line: String, folder: Path): Result<Resolved, String> = {
    rest = line.substringAfter(" ")
    when (line.substringBefore(" ")) {
      "root" -> Ok(resolved.copy(roots = resolved.roots + [folder.resolve(rest)]))
      "library" -> CoordinatesText.read(rest).map { lib -> resolved.copy(libraries = resolved.libraries + [lib]) }
      else -> Error("kiln roots said '$line', which is neither a root nor a library")
    }
  }
}
