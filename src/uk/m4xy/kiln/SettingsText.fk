import fckt.io.Paths.*
import fckt.text.Format

// Settings as they pass from settings.fk to kiln, which compiles settings.fk with a main that
// prints them and reads what it prints: a line for each repository, in the order they're tried;
// each thing build scripts use; and each project, with folders as settings.fk has them, which
// Folders makes whole from where it is.
module SettingsText : Format {
  type T = Settings

  of(value: Settings): String =
    (value.repositories.map { "repository ${RepositoryText.of(it)}" } +
      value.uses.map { "uses ${DependencyText.of(it)}" } +
      value.projects.map { "project ${it.value}" }).joinToString("\n")

  read(text: String): Result<Settings, String> =
    text.lines().filter { it.isNotBlank() }.foldResult(Settings(repositories = [], uses = [], projects = [])) { settings, line -> withLine(settings, line.trim()) }

  private withLine(settings: Settings, line: String): Result<Settings, String> = {
    rest = line.substringAfter(" ")
    when (line.substringBefore(" ")) {
      "repository" -> RepositoryText.read(rest).map { settings.copy(repositories = settings.repositories + [it]) }
      "uses" -> DependencyText.read(rest).map { settings.copy(uses = settings.uses + [it]) }
      "project" -> Ok(settings.copy(projects = settings.projects + [path(rest)]))
      else -> Error("there's no setting '$line'")
    }
  }
}
