import fckt.io.Path
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import fckt.io.Process
import fckt.io.FileSystem
import fckt.text.Digests.*
import uk.m4xy.kiln.Dependencies.*
import fckt.effects.Fail
import fckt.io.Console
import uk.m4xy.kiln.*

// Compiling with fckt and OCaml. fckt's core, the standard library and each library are compiled once, into
// kiln's cache, for this fckt and OCaml; a program is checked against the libraries' interfaces,
// compiled on its own, and linked with them.
module Compiling {
  // The fckt compiler: FCKT, or fckt where the shell finds it.
  @Process compiler(): String = env("FCKT").getOrElse("fckt")

  // Runs command, and fails with what it printed if it doesn't exit with 0.
  @Process runOrFail(command: String, args: List<String>): Unit = {
    output(command, args)
    Unit
  }

  // What command prints, run with args; it not exiting with 0 fails.
  @Process output(command: String, args: List<String>): String = {
    exit = run(command, args)
    if (exit.code != 0) fail("${command.substringAfterLast("/")} failed:\n${exit.value.trim()}")
    exit.value
  }

  // A program at program, which compile makes from OCaml it writes to the path it's given, unless
  // it's up to date: compiled from inputs, a digest of what it's compiled from, as inputs makes;
  // its OCaml is in output. Whether it was compiled.
  @Building buildProgram(output: Path, program: Path, inputs: String, compile: @Building (Path) -> Unit): Boolean = {
    ocaml = output.resolve("ocaml")
    stamp = ocaml.resolve(program.name + ".inputs")
    if (program.exists() && stamp.exists() && stamp.readText() == inputs) false
    else {
      ocaml.makeDirs()
      stamp.delete()
      when (program.parent) {
        Some(dir) -> dir.makeDirs()
        None -> Unit
      }
      compile(ocaml.resolve(program.name + ".ml"))
      stamp.writeText(inputs)
      true
    }
  }

  // Where kiln keeps what it's compiled: ~/.kiln/cache, or KILN_CACHE.
  @Process internal cache(): Path = when (env("KILN_CACHE")) {
    Some(folder) -> path(folder)
    None -> path(env("HOME").getOrElse(".")).resolve(".kiln/cache")
  }

  // fckt's core, the standard library and the libraries resolved, compiled if they aren't yet.
  @Building linking(resolved: Resolved): Linking = {
    // What one fckt or OCaml compiled, another can't use, so each has its own folder.
    toolchain = cache().resolve((fcktVersion() + output("ocamlopt", ["-version"])).md5().take(16))
    core = coreOf(toolchain)
    std = if (resolved.standardLibrary) [standardLibrary(toolchain, core)] else []
    libraries = resolved.libraries.fold(std) { done, lib -> compileLibrary(toolchain, core, std, resolved.libraries, lib, [], done, resolved.repositories) }
    Linking(core, libraries, (resolved.ocamlPackages + libraries.flatMap { it.ocamlPackages }).distinct())
  }

  // What fckt --version says.
  @Building private fcktVersion(): String = fcktSays(["--version"])

  // What fckt says to args, remembered for the fckt that said it, as asking means starting a JVM:
  // asked again only when fckt, or what's beside it, as its jars, changes.
  @Building private fcktSays(args: List<String>): String = {
    found = output("sh", ["-c", "command -v \"\$1\" || true", "sh", compiler()]).trim()
    if (found.isEmpty()) fail("there's no ${compiler()} to compile with: put fckt on PATH, or say where it is with FCKT")
    program = path(found).canonical()
    // Its folder's and the folder beside it's files: an installed fckt's bin and lib.
    near = program.parent.map { it.listFiles() + it.resolve("../lib").listFilesOrNone() }.getOrElse([])
    stamp = ([program] + near).map { "${it.value} ${it.lastModified().millis}" }.joinToString("\n") + "\n" + args.joinToString(" ")
    remembered = cache().resolve("fckt").resolve(stamp.md5().take(16))
    if (remembered.exists()) remembered.readText()
    else {
      said = output(compiler(), args)
      cache().resolve("fckt").makeDirs()
      remembered.writeText(said)
      said
    }
  }

  // What tells fckt where packages are: own, the project's folders, as the program's, and the rest of
  // roots as other projects', whose internal declarations it doesn't see.
  sourceArgs(own: List<Path>, roots: List<Path>): List<String> =
    roots.flatMap { if (own.contains(it)) ["-I", it.value] else ["--other-project", it.value] }

  // file to OCaml at ml, with the packages in roots, own the project's, and the libraries', then to
  // a program.
  @Building internal compileProgram(linking: Linking, own: List<Path>, roots: List<Path>, file: Path, ml: Path, program: Path): Unit = {
    libraries = linking.libraries
    runOrFail(compiler(), [file.value, "-o", ml.value, "--separate", "--no-std"] + sourceArgs(own, roots) + interfaces(libraries))
    linkProgram(linking, ml, program)
  }

  // The OCaml at ml, linked with the core and the libraries, the standard library among them, to program.
  @Building linkProgram(linking: Linking, ml: Path, program: Path): Unit = {
    libraries = linking.libraries
    ocamlopt(linking.ocamlPackages, true, ["-w", "-a", "-I", linking.core.value] + libraries.flatMap { ["-I", it.folder.value] } +
      [linking.core.resolve("fckt_core.cmx").value] + libraries.map { it.folder.resolve("${it.unit}.cmx").value } +
      [ml.value, "-o", program.value])
  }

  // Runs ocamlopt with args, with unix and packages, which ocamlfind finds where opam installed
  // them; and, to link, links them.
  @Building private ocamlopt(packages: List<String>, link: Boolean, args: List<String>): Unit =
    if (packages.isEmpty()) runOrFail("ocamlopt", ["-I", "+unix"] + (if (link) ["unix.cmxa"] else []) + args)
    else {
      (command, before) = ocamlfind()
      runOrFail(command, before + ["ocamlopt", "-package", (["unix"] + packages).joinToString(",")] + (if (link) ["-linkpkg"] else []) + args)
    }

  // How to run ocamlfind: where the shell finds it, or through opam, in its current switch, so
  // opam's environment needn't be in the shell's.
  @Building private ocamlfind(): (String, List<String>) =
    if (onPath("ocamlfind")) ("ocamlfind", [])
    else if (onPath("opam")) ("opam", ["exec", "--", "ocamlfind"])
    else fail("a library calls OCaml packages, which need ocamlfind: install opam, then opam install ocamlfind and the packages")

  @Process private onPath(command: String): Boolean = output("sh", ["-c", "command -v \"\$1\" || true", "sh", command]).trim().isNotEmpty()

  // packages, from roots, as a library: OCaml at ml, which is the module unit, and its interface,
  // which programs that use it are checked against, in folder interface.
  @Building internal compilePackages(linking: Linking, own: List<Path>, roots: List<Path>, packages: List<String>, unit: String, ml: Path, interface: Path): Unit = {
    runOrFail(compiler(), ["--library", interface.value, "-o", ml.value, "--no-std"] + sourceArgs(own, roots) + interfaces(linking.libraries) + packages)
    ocamlopt(linking.ocamlPackages, false, ["-c", "-w", "-a", "-I", linking.core.value] + linking.libraries.flatMap { ["-I", it.folder.value] } + [ml.value])
  }

  // Where a published library lists the OCaml packages it calls, one a line.
  packagesFile: String = "ocaml-packages"

  // The OCaml module a library is: uk_m4xy_json for uk.m4xy:json.
  internal unitOf(group: String, name: String): String =
    "${group}_$name".replace(".", "_").replace("-", "_").lowercase()

  // The packages in folder and those in it, as names from root: uk.m4xy.money.
  @FileSystem internal packagesIn(root: Path, folder: Path): List<String> = {
    children = folder.listFiles()
    own = if (folder != root && children.any { it.extension == "fk" && !it.isDirectory() }) [folder.relativeTo(root).getOrElse(folder).names.joinToString(".")] else []
    own + children.filter { it.isDirectory() }.flatMap { packagesIn(root, it) }
  }

  // What a program or library compiled with linking from roots, and files beside, is compiled
  // from, as a digest: fckt and OCaml, the libraries, and each source file's name and text. Where
  // it's what it was, what was compiled then is what would be now.
  @FileSystem inputs(linking: Linking, roots: List<Path>, files: List<Path>): String =
    ([linking.core.value] + linking.libraries.map { it.folder.value } +
      (roots.flatMap { sourcesIn(it) } + files).map { "${it.value}\n${it.readText()}" }).joinToString("\n").md5()

  interfaces(libraries: List<CompiledLibrary>): List<String> = libraries.flatMap { ["-L", it.folder.resolve("interface").value] }

  // fckt's core, compiled once: fckt_core, in toolchain's core.
  @Building private coreOf(toolchain: Path): Path = {
    folder = toolchain.resolve("core")
    if (!folder.resolve("done").exists()) {
      folder.delete()
      folder.makeDirs()
      ml = folder.resolve("fckt_core.ml")
      runOrFail(compiler(), ["--core", "-o", ml.value])
      runOrFail("ocamlopt", ["-c", "-w", "-a", "-I", "+unix", ml.value])
      folder.resolve("done").writeText("")
    }
    folder
  }

  // The standard library, fckt:std, compiled once, with the core, from the source beside the fckt
  // that compiles it, so it's always that fckt's: Fckt_std, in toolchain's std, under a digest of
  // that source, as it can change while fckt doesn't.
  @Building private standardLibrary(toolchain: Path, core: Path): CompiledLibrary = {
    src = path(fcktSays(["--std-path"]).trim())
    key = sourcesIn(src).map { "${it.relativeTo(src).getOrElse(it).value}\n${it.readText()}" }.joinToString("\n").md5().take(16)
    folder = toolchain.resolve("std-$key")
    unit = "Fckt_std"
    if (!folder.resolve("done").exists()) {
      println("  compiling the standard library")
      folder.delete()
      folder.makeDirs()
      compilePackages(Linking(core, []), [src], [src], packagesIn(src, src), unit, folder.resolve("fckt_std.ml"), folder.resolve("interface"))
      folder.resolve("done").writeText("")
    }
    CompiledLibrary(Coordinates("fckt", "std", fcktVersion()), folder, unit)
  }

  // done, with lib compiled after the libraries it uses, unless it is already. Of those chosen,
  // the versions it uses; through, the libraries that led to it, which it can't use in turn.
  // std, the standard library, if there is one, every library is compiled with.
  @Building private compileLibrary(toolchain: Path, core: Path, std: List<CompiledLibrary>, chosen: List<Coordinates>, lib: Coordinates, through: List<Coordinates>, done: List<CompiledLibrary>, repositories: List<Repository>): List<CompiledLibrary> =
    if (done.any { it.coordinates == lib }) done
    else {
      if (through.contains(lib)) fail("${(through + [lib]).map { CoordinatesText.of(it) }.joinToString(" uses ")}, so none can be compiled first")
      uses = usedBy(lib, chosen, repositories)
      before = uses.fold(done) { all, used -> compileLibrary(toolchain, core, std, chosen, used, through + [lib], all, repositories) }
      // What it uses, and what they do: their interfaces' types are its interface's.
      needed = closure(uses, chosen, [], repositories)
      before + [compileOne(toolchain, core, lib, std + before.filter { needed.contains(it.coordinates) }, repositories)]
    }

  // Of those chosen, the versions of the libraries lib says it uses.
  @FileSystem @Process private usedBy(lib: Coordinates, chosen: List<Coordinates>, repositories: List<Repository>): List<Coordinates> =
    published(lib, repositories).flatMap { d ->
      when (d) {
        Library(wanted) -> chosen.filter { it.group == wanted.group && it.name == wanted.name }
        Folder(_) -> []
        Kiln -> []
      }
    }

  // libs, with those they use, and those they use.
  @FileSystem @Process private closure(libs: List<Coordinates>, chosen: List<Coordinates>, found: List<Coordinates>, repositories: List<Repository>): List<Coordinates> = when (libs) {
    [] -> found
    [lib, *rest] -> if (found.contains(lib)) closure(rest, chosen, found, repositories) else closure(rest + usedBy(lib, chosen, repositories), chosen, found + [lib], repositories)
  }

  // lib's packages, compiled with the libraries it uses: once for each source it's published
  // with, and each set of those, so publishing it again compiles it again.
  @Building private compileOne(toolchain: Path, core: Path, lib: Coordinates, uses: List<CompiledLibrary>, repositories: List<Repository>): CompiledLibrary = {
    published = folderOf(lib, repositories).getOrElse(publishedAt(lib))
    src = published.resolve("src")
    // What it calls of OCaml's packages, as published, and what the libraries it uses do.
    ocamlPackages = ((if (published.resolve(packagesFile).exists()) published.resolve(packagesFile).readLines().filter { it.isNotBlank() } else []) +
      uses.flatMap { it.ocamlPackages }).distinct()
    files = sourcesIn(src).map { "${it.relativeTo(src).getOrElse(it).value}\n${it.readText()}" }
    key = ([CoordinatesText.of(lib)] + files + uses.map { it.folder.name }).joinToString("\n").md5().take(12)
    folder = toolchain.resolve("libraries/${lib.group}/${lib.name}/${lib.version}-$key")
    unit = unitOf(lib.group, lib.name)
    if (!folder.resolve("done").exists()) {
      println("  compiling ${CoordinatesText.of(lib)}")
      folder.delete()
      folder.makeDirs()
      compilePackages(Linking(core, uses, ocamlPackages), [src], [src], packagesIn(src, src), unit, folder.resolve("$unit.ml"), folder.resolve("interface"))
      folder.resolve("done").writeText("")
    }
    CompiledLibrary(lib, folder, unit, ocamlPackages)
  }

  // The .fk files in folder and those in it.
  @FileSystem internal sourcesIn(folder: Path): List<Path> =
    if (!folder.isDirectory()) []
    else folder.listFiles().flatMap { f -> if (f.isDirectory()) sourcesIn(f) else if (f.extension == "fk") [f] else [] }

  // The folder's files, or none if it isn't one.
  @FileSystem private Path.listFilesOrNone(): List<Path> = if (this.isDirectory()) this.listFiles() else []
}
