import uk.m4xy.kiln.*

// The Fckt plugin's tasks, as others name them: a script's task that needs the program first
// depends on FcktTasks.compile.
module FcktTasks {
  process: TaskName = Named("process")
  compile: TaskName = Named("compile")
  run: TaskName = Named("run")
  publishLocal: TaskName = Named("publishLocal")
  roots: TaskName = Named("roots")
  update: TaskName = Named("update")
  format: TaskName = Named("format")
  checkFormat: TaskName = Named("checkFormat")
}
