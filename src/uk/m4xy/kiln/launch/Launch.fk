import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import uk.m4xy.kiln.*

// What kiln does when it's run: it reads settings.fk, in this folder, or the nearest above that lists
// this one in its projects: where libraries are looked for, what build scripts use, and which
// projects are built with this one. Then it adds a main to the build script, which hands project,
// with its tasks and plugins, to uk.m4xy.kiln's runBuild, compiles that with fckt and ocamlopt to
// .kiln/build, again only when it changes, and runs it.
internal module Launch {
  // Runs the tasks args names, in the projects the settings here list, then on the project here, and
  // gives the exit code. roots is about this project only, for another that depends on it.
  @Console @FileSystem @Process build(args: List<String>): Int = {
    here = workingDirectory()
    settings = SettingsFiles.settingsFor(here)
    names = args.takeWhile { it != "--" }
    included = when (settings) {
      Some(found) -> if (found.folder == here && !names.contains("roots")) found.settings.projects else []
      None -> []
    }
    failed = included.find { folder ->
      println("> Project ${folder.value.removePrefix(here.value + "/")}")
      runAttached(executable().value, ["-C", folder.value] + args) != 0
    }
    if (failed.isSome()) 1
    else if (path("build.fk").exists()) script(settings, args)
    else if (included.isNotEmpty()) 0
    else {
      println("kiln: there's no build.fk here, so no project to build")
      2
    }
  }

  // The build script here, compiled with what the settings say it uses, run with args.
  @Console @FileSystem @Process private script(settings: Option<FoundSettings>, args: List<String>): Int = {
    declared = Scripts.declarations(path("build.fk"), "build.fk", path(".kiln"))
    if (declared.contains("main")) {
      println("build.fk: it declares project, and kiln runs it, so it can't have a main")
      1
    } else if (!declared.contains("project")) {
      println("build.fk: it must declare project = Project(name = \"...\")")
      1
    } else if (declared.contains("uses")) {
      println("build.fk: the libraries and projects it's compiled with go in settings.fk, settings = Settings(uses = [...]); plugins = [...] applies their plugins, as modules")
      1
    } else {
      found = settings.getOrElse(FoundSettings(path("."), Settings()))
      given = ["tasks", "plugins"].filter { declared.contains(it) }.map { ", $it = $it" }.joinToString("")
      repositories = found.settings.repositories.map { r ->
        when (r) {
          Local -> "Local"
          At(folder) -> "At(path(${Scripts.quoted(folder.value)}))"
        }
      }.joinToString(", ")
      // The script, then its main, so the script's lines keep their numbers: its folders aren't
      // packages, as src would be if the project's folder were one of fckt's.
      program = "${path("build.fk").readText()}\n\nmain(args: List<String>) = uk.m4xy.kiln.Builds.runBuild(project.copy(repositories = [$repositories]), args$given)\n"
      code = Scripts.compile(program, "build.fk", path(".kiln"), [Scripts.library()] + PluginSources.of(found.settings.uses, found.settings.repositories))
      // A plugin's tasks use kiln's library, as kiln() says, from where this kiln has it.
      setEnv("KILN_LIB", Scripts.library().value)
      if (code != 0) 1 else runAttached(path(".kiln/build").value, args)
    }
  }
}
