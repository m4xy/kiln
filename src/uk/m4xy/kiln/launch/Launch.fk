import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import uk.m4xy.kiln.*
import uk.m4xy.kiln.Folders.*

// What kiln does when it's run. It looks for settings.fk, in this folder, or the nearest above, and
// compiles it with a main that hands what it declares to withSettings: where libraries are looked
// for, what build scripts use, and which projects are built with the one in its folder, if they
// apply here. Then it compiles the build script, with settings.fk beside it, and a main that hands
// project, tasks, plugins and settings to uk.m4xy.kiln's runBuild, with fckt and ocamlopt, to
// .kiln/build, again only when they change, and runs it. Each is a value, as declared: none of it
// passes as text.
module Launch {
  // kiln, run here with args: its exit code.
  @Console @FileSystem @Process internal start(args: List<String>): Int = {
    // For what this runs: kiln itself, as kiln runs other projects, and its library, which a plugin's tasks use.
    setEnv("KILN", executable().value)
    setEnv("KILN_LIB", Scripts.library().value)
    here = workingDirectory()
    when (SettingsFiles.nearest(here)) {
      Some(folder) -> SettingsFiles.run(folder, args)
      None -> build(here, None, args)
    }
  }

  // What settings.fk's main does with the settings it declares, written from KILN_SETTINGS, where
  // it is: builds here with them, if they're its folder's, or list this one in their projects.
  @Console @FileSystem @Process withSettings(settings: Settings, args: List<String>): Unit = {
    folder = path(env("KILN_SETTINGS").getOrElse("."))
    here = workingDirectory()
    whole = settings.from(folder)
    exit(build(here, if (folder == here || whole.projects.contains(here)) Some(FoundSettings(folder, whole)) else None, args))
  }

  // Runs the tasks args names, in the projects the settings list, then on the project here, and
  // gives the exit code. Run --quiet, for another program to read, it's about this project only.
  @Console @FileSystem @Process private build(here: Path, settings: Option<FoundSettings>, args: List<String>): Int = {
    names = args.takeWhile { it != "--" }
    included = when (settings) {
      Some(found) -> if (found.folder == here && !names.contains("--quiet")) found.settings.projects else []
      None -> []
    }
    failed = included.find { folder ->
      println("> Project ${folder.value.removePrefix(here.value + "/")}")
      runAttached(env("KILN").getOrElse("kiln"), ["-C", folder.value] + args) != 0
    }
    if (failed.isSome()) 1
    else if (path("build.fk").exists()) script(settings, args)
    else if (included.isNotEmpty()) 0
    else {
      println("kiln: there's no build.fk here, so no project to build")
      2
    }
  }

  // The build script here, compiled with settings.fk beside it, if it applies, and what it says
  // build scripts use; run with args.
  @Console @FileSystem @Process private script(settings: Option<FoundSettings>, args: List<String>): Int = {
    main = "main(args: List<String>) = uk.m4xy.kiln.Builds.runBuild(project, args, tasks, plugins, settings)\n"
    scripts = [path("build.fk")] + settings.map { [it.folder.resolve("settings.fk")] }.getOrElse([])
    uses = settings.map { PluginSources.of(it.settings.uses, it.settings.repositories) }.getOrElse([])
    code = Scripts.compile(main, scripts, path(".kiln"), [Scripts.library()] + uses, Scripts.imports + ["uk.m4xy.kiln.defaults.*"])
    if (code != 0) 1 else runAttached(path(".kiln/build").value, args)
  }
}
