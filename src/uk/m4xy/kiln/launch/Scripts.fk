import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import fckt.text.Digests.*
import uk.m4xy.kiln.fckt.Compiling
import uk.m4xy.kiln.fckt.Compiling.compiler
import uk.m4xy.kiln.fckt.Compiling.sourcesIn
import uk.m4xy.kiln.fckt.CompiledLibrary
import uk.m4xy.kiln.fckt.Linking
import uk.m4xy.kiln.fckt.Resolved
import uk.m4xy.kiln.Coordinates
import uk.m4xy.kiln.Building

// Scripts, settings.fk and build.fk: compiled, as they are, with a main kiln gives them.
internal module Scripts {
  // What a script imports without saying: what it needs to say what its project is, and to print
  // and fail.
  imports: List<String> = [
    "uk.m4xy.kiln.*", "uk.m4xy.kiln.Builds.*", "uk.m4xy.kiln.Dependencies.*",
    "fckt.io.Path", "fckt.io.FileSystem", "fckt.io.Process", "fckt.io.Paths.*", "fckt.io.Files.*", "fckt.io.Processes.*",
    "fckt.io.Console", "fckt.effects.Fail",
  ]

  // Compiles scripts, copied beside main, a main.fk that names what they declare, to cache/build,
  // with fckt, against kiln's library and the standard library, compiled once, with the plugins'
  // roots on its path and imports in each, and ocamlopt, unless they're as they were compiled
  // last: running the OCaml as a script would type-check all of it every time. Its exit code;
  // what fckt says is wrong is said of the scripts, where they are.
  @Console @FileSystem @Process compile(
    main: String,
    scripts: List<Path>,
    cache: Path,
    roots: List<Path>,
    imports: List<String>,
  ): Int = {
    built = cache.resolve("build")
    stamp = cache.resolve("stamp")
    key = (["kiln $version", main] + scripts.map { "${it.value}\n${it.readText()}" } + ([library()] + roots).flatMap { sourcesIn(it) }.map { it.readText() } + imports).joinToString(
      "\n",
    )
    if (built.exists() && stamp.exists() && stamp.readText() == key) 0
    else {
      // Made in a folder of its own, so kiln compiling it more than once at a time, as kiln run
      // twice in a project, or in projects that share settings.fk, does, never sees another half
      // done; then moved into place.
      cache.makeDirs()
      work = path(
        Compiling.output("mktemp", ["-d", cache.resolve("compiling.XXXXXX").value]).trim(),
      )
      src = work.resolve("src")
      ml = work.resolve("build.ml")
      // Only these, as every file beside main is the program's.
      src.makeDirs()
      src.resolve("main.fk").writeText(main)
      scripts.forEach { it.copyTo(src.resolve(it.name)) }
      // kiln's library and the plugins' are other projects: the script sees what they publish, not what's internal to them.
      linking = withKiln(Compiling.linking(Resolved([], [])))
      exit = run(
        compiler(),
        [
          src.resolve("main.fk").value,
          "-o",
          ml.value,
          "--separate",
          "--no-std",
        ] + roots.flatMap { ["--other-project", it.value] } + imports.flatMap { ["--import", it] } +
          Compiling.interfaces(linking.libraries),
      )
      if (exit.code != 0) {
        print(
          scripts.fold(
            exit.value.replace(
              src.resolve("main.fk").value,
              "the main kiln adds to ${scripts.firstOrNone().map { it.name }.getOrElse("the script")}",
            ),
          ) { text, script -> text.replace(src.resolve(script.name).value, script.value) },
        )
        work.delete()
        exit.code
      } else {
        native = run("ocamlopt", linked(linking, ml, work.resolve("build")))
        if (native.code == 0) {
          work.resolve("stamp").writeText(key)
          Compiling.moved(work.resolve("build").value, built.value)
          Compiling.moved(work.resolve("stamp").value, stamp.value)
          Unit
        } else print(native.value)
        work.delete()
        native.code
      }
    }
  }

  // linking, with kiln's library, compiled once for its source and the libraries it's compiled with.
  @Building private withKiln(linking: Linking): Linking = {
    src = library()
    key = (sourcesIn(src).map { "${it.relativeTo(src).getOrElse(it).value}\n${it.readText()}" } +
      linking.libraries.map { it.folder.name }).joinToString("\n").md5().take(16)
    folder = linking.core.resolve("../kiln-$key")
    unit = "uk_m4xy_kiln"
    Compiling.made(folder) { at ->
      Compiling.compilePackages(
        linking,
        [src],
        [src],
        Compiling.packagesIn(src, src),
        unit,
        at.resolve("$unit.ml"),
        at.resolve("interface"),
      )
    }
    Linking(
      linking.core,
      linking.libraries + [CompiledLibrary(Coordinates("uk.m4xy", "kiln", version), folder, unit)],
    )
  }

  // ocamlopt's arguments to link the OCaml at ml with linking's core and libraries, to program.
  private linked(linking: Linking, ml: Path, program: Path): List<String> =
    ["-w", "-a", "-I", "+unix", "-I", linking.core.value] +
      linking.libraries.flatMap { ["-I", it.folder.value] } + ["unix.cmxa", linking.core.resolve("fckt_core.cmx").value] +
      linking.libraries.map { it.folder.resolve("${it.unit}.cmx").value } + [ml.value, "-o", program.value]

  // Where uk.m4xy.kiln's source is: KILN_LIB; or lib/kiln beside the folder kiln is in, as it's
  // installed; or, built where it's developed, its src.
  @FileSystem @Process library(): Path = when (env("KILN_LIB")) {
    Some(folder) -> path(folder)
    None -> {
      home = executable().parent.getOrElse(path(".")).resolve("..")
      installed = home.resolve("lib/kiln")
      if (installed.isDirectory()) installed else home.resolve("../src")
    }
  }
}
