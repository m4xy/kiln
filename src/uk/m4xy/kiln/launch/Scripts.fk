import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import uk.m4xy.kiln.fckt.Compiling.compiler
import uk.m4xy.kiln.fckt.Compiling.sourcesIn

// Scripts, settings.fk and build.fk: compiled, as they are, with a main kiln gives them.
internal module Scripts {
  // What a script imports without saying: what it needs to say what its project is, and to print
  // and fail.
  imports: List<String> = [
    "uk.m4xy.kiln.*", "uk.m4xy.kiln.Builds.*", "uk.m4xy.kiln.Dependencies.*",
    "fckt.io.Path", "fckt.io.FileSystem", "fckt.io.Process", "fckt.io.Paths.*", "fckt.io.Files.*", "fckt.io.Processes.*",
    "fckt.io.Console", "fckt.effects.Fail",
  ]

  // Compiles scripts, copied beside main, a main.fk that names what they declare, to cache/build,
  // with fckt, roots on its path, imports in each, and ocamlopt, unless they're as they were
  // compiled last: running the OCaml as a script would type-check all of it every time. Its exit
  // code; what fckt says is wrong is said of the scripts, where they are.
  @Console @FileSystem @Process compile(
    main: String,
    scripts: List<Path>,
    cache: Path,
    roots: List<Path>,
    imports: List<String>,
  ): Int = {
    src = cache.resolve("src")
    ml = cache.resolve("build.ml")
    built = cache.resolve("build")
    stamp = cache.resolve("stamp")
    key = (["kiln $version", main] + scripts.map { "${it.value}\n${it.readText()}" } + roots.flatMap { sourcesIn(it) }.map { it.readText() } + imports).joinToString(
      "\n",
    )
    if (built.exists() && stamp.exists() && stamp.readText() == key) 0
    else {
      stamp.delete()
      // Only these, as every file beside main is the program's.
      src.delete()
      src.makeDirs()
      src.resolve("main.fk").writeText(main)
      scripts.forEach { it.copyTo(src.resolve(it.name)) }
      // kiln's library and the plugins' are other projects: the script sees what they publish, not what's internal to them.
      exit = run(
        compiler(),
        [
          src.resolve("main.fk").value,
          "-o",
          ml.value,
        ] + roots.flatMap { ["--other-project", it.value] } + imports.flatMap { ["--import", it] },
      )
      if (exit.code != 0) {
        print(
          scripts.fold(
            exit.value.replace(
              src.resolve("main.fk").value,
              "the main kiln adds to ${scripts.firstOrNone().map { it.name }.getOrElse("the script")}",
            ),
          ) { text, script -> text.replace(src.resolve(script.name).value, script.value) },
        )
        exit.code
      } else {
        native = run(
          "ocamlopt",
          ["-w", "-a", "-I", "+unix", "unix.cmxa", ml.value, "-o", built.value],
        )
        if (native.code == 0) stamp.writeText(key) else print(native.value)
        native.code
      }
    }
  }

  // Where uk.m4xy.kiln's source is: KILN_LIB; or lib/kiln beside the folder kiln is in, as it's
  // installed; or, built where it's developed, its src.
  @FileSystem @Process library(): Path = when (env("KILN_LIB")) {
    Some(folder) -> path(folder)
    None -> {
      home = executable().parent.getOrElse(path(".")).resolve("..")
      installed = home.resolve("lib/kiln")
      if (installed.isDirectory()) installed else home.resolve("../src")
    }
  }
}
