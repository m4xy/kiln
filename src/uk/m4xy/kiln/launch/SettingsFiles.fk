import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*
import uk.m4xy.kiln.*
import uk.m4xy.kiln.Folders.*

// Finding and reading settings.fk: compiled with a main that prints what it says, as SettingsText
// writes it, which is read back.
internal module SettingsFiles {
  // The settings that apply here: settings.fk here, or in the nearest folder above that has one, if
  // it lists this one in its projects.
  @Console @FileSystem @Process settingsFor(here: Path): Option<FoundSettings> = when (nearest(here)) {
    None -> None
    Some(folder) -> {
      found = read(folder)
      if (found.folder == here || found.settings.projects.contains(here)) Some(found) else None
    }
  }

  // The nearest folder with a settings.fk: folder, or one it's in.
  @FileSystem private nearest(folder: Path): Option<Path> =
    if (folder.resolve("settings.fk").exists()) Some(folder)
    else when (folder.parent) {
      Some(up) -> if (up == folder) None else nearest(up)
      None -> None
    }

  // What folder's settings.fk says: compiled with kiln's library alone, so it can't use what it says
  // build scripts use; and run.
  @Console @FileSystem @Process private read(folder: Path): FoundSettings = {
    file = folder.resolve("settings.fk")
    cache = folder.resolve(".kiln/settings")
    if (!Scripts.declarations(file, "settings.fk", cache).contains("settings")) {
      println("settings.fk: it must declare settings = Settings(...)")
      exit(1)
    }
    program = "${file.readText()}\n\nmain(args: List<String>) = println(uk.m4xy.kiln.SettingsText.of(settings))\n"
    if (Scripts.compile(program, "settings.fk", cache, [Scripts.library()]) != 0) exit(1)
    said = run(cache.resolve("build").value, [])
    if (said.code != 0) {
      print(said.value)
      exit(1)
    }
    when (SettingsText.read(said.value)) {
      Ok(settings) -> FoundSettings(folder, settings.from(folder))
      Error(problem) -> {
        println("settings.fk: $problem")
        exit(1)
      }
    }
  }
}
