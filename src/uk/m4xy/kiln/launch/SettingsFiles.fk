import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Console
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*

// settings.fk: found, and compiled with a main that hands the settings it declares, as they are, to
// Launch.withSettings, which goes on from there.
internal module SettingsFiles {
  // The nearest folder with a settings.fk: folder, or one it's in.
  @FileSystem nearest(folder: Path): Option<Path> =
    if (folder.resolve("settings.fk").exists()) Some(folder)
    else when (folder.parent) {
      Some(up) -> if (up == folder) None else nearest(up)
      None -> None
    }

  // Compiles folder's settings.fk, with kiln's library alone, so it can't use what it says build
  // scripts use, and runs it with args, here: its exit code.
  @Console @FileSystem @Process run(folder: Path, args: List<String>): Int = {
    cache = folder.resolve(".kiln/settings")
    main = "main(args: List<String>) = uk.m4xy.kiln.launch.Launch.withSettings(settings, args)\n"
    if (Scripts.compile(main, [folder.resolve("settings.fk")], cache, [], Scripts.imports) != 0) 1
    else {
      setEnv("KILN_SETTINGS", folder.value)
      runAttached(cache.resolve("build").value, args)
    }
  }
}
