import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Paths.*
import fckt.io.Files.*
import uk.m4xy.fktests.api.Test

prices = "module Prices {\n  total(items: List<Int>): Int = items.sum()\n}\n"

// A project compiles and runs, with tasks of its own, each run once, after what it depends on.
@Test @FileSystem @Process tasksRunAfterWhatTheyDependOn() = {
  shop = projects("shop")
  write(shop, "src/pricing/Prices.fk", prices)
  write(shop, "src/main.fk", "import pricing.Prices\n\nmain(args: List<String>) = println(\"total \${Prices.total([1, 2, 3])} for \${args.joinToString(\" \")}\")\n")
  write(shop, "build.fk", """project = Project(name = "shop", version = "1.2.0")

tasks = standardTasks + [
  Task("stamp", "Writes the version", dependsOn = ["compile"], action = build -> build.project.output.resolve("VERSION").writeText(build.project.version)),
]
""")
  expectContains(kiln(shop, ["tasks"]).value, "  stamp - Writes the version")
  assertEquals("> Task :compile\n> Task :check\n> Task :build\nBUILD SUCCESSFUL\n", kiln(shop, ["build"]).value)
  // What's up to date isn't compiled again; what follows -- is the tasks', as the program's for run.
  assertEquals("> Task :compile\n  up to date\n> Task :run\ntotal 6 for a b\n> Task :stamp\nBUILD SUCCESSFUL\n", kiln(shop, ["run", "stamp", "--", "a", "b"]).value)
  assertEquals("1.2.0", shop.resolve("build/VERSION").readText())
  // A change to what it's compiled from compiles it again.
  write(shop, "src/pricing/Prices.fk", "module Prices {\n  total(items: List<Int>): Int = items.fold(0, (a, b) -> a + b)\n}\n")
  assertEquals("> Task :compile\n> Task :check\n> Task :build\nBUILD SUCCESSFUL\n", kiln(shop, ["build"]).value)
}

// A task part of check runs when check does, and so when build does; one that fails fails the build.
@Test @FileSystem @Process aTaskPartOfCheckRunsWithIt() = {
  lint = projects("lint")
  write(lint, "src/pricing/Prices.fk", prices)
  write(lint, "build.fk", """project = Project(name = "lint")

tasks = standardTasks + [
  Task("lint", "Looks at the code", partOf = ["check"], action = build -> if (build.args.contains("strict")) fail("too loose") else println("  looks fine")),
]
""")
  assertEquals("> Task :compile\n  checked 1 package: pricing\n> Task :lint\n  looks fine\n> Task :check\n> Task :build\nBUILD SUCCESSFUL\n", kiln(lint, ["build"]).value)
  failed = kiln(lint, ["check", "--", "strict"])
  assertEquals(1, failed.code)
  expectContains(failed.value, "> Task :lint\nBUILD FAILED: too loose")
}

// A plugin is a library, or a project, whose functions make tasks with kiln's library.
@Test @FileSystem @Process aPluginMakesTasks() = {
  dir = projects("plugins")
  write(dir, "greeting/build.fk", "project = Project(name = \"greeting\", group = \"uk.m4xy\", version = \"1.0.0\", dependencies = [kiln()])\n")
  write(dir, "greeting/src/uk/m4xy/greeting/Greetings.fk", """import uk.m4xy.kiln.*

module Greetings {
  greet(greeting: String): Task = Task("greet", "Greets the project", action = build -> println("  " + greeting + ", " + build.project.name))
}
""")
  write(dir, "shop/src/pricing/Prices.fk", prices)
  shop = dir.resolve("shop")
  build = (plugin: String) -> write(shop, "build.fk", """import uk.m4xy.greeting.Greetings.*

plugins = [$plugin]

project = Project(name = "shop")

tasks = standardTasks + [greet("hello")]
""")
  build("projectAt(\"../greeting\")")
  assertEquals("> Task :greet\n  hello, shop\nBUILD SUCCESSFUL\n", kiln(shop, ["greet"]).value)
  // Published, it's used from the repository.
  build("library(\"uk.m4xy:greeting:1.0.0\")")
  expectContains(kiln(shop, ["greet"]).value, "build.fk: its plugin uk.m4xy:greeting:1.0.0 isn't in")
  assertEquals(0, kiln(dir.resolve("greeting"), ["publishLocal"]).code)
  assertEquals("> Task :greet\n  hello, shop\nBUILD SUCCESSFUL\n", kiln(shop, ["greet"]).value)
  // kiln's library isn't published with it, as kiln has it.
  assertEquals("", path("build/test-repository/uk.m4xy/greeting/1.0.0/dependencies").readText())
}

// What isn't a project, or a task, says so.
@Test @FileSystem @Process whatIsntAProjectSaysSo() = {
  shop = projects("nothing")
  write(shop, "src/pricing/Prices.fk", prices)
  write(shop, "build.fk", "project = Project(name = \"nothing\")\n")
  assertEquals(2, kiln(shop.resolve("src"), ["build"]).code)
  expectContains(kiln(shop, ["nope"]).value, "BUILD FAILED: there's no task 'nope'")
}
