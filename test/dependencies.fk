import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Paths.*
import fckt.io.Files.*
import uk.m4xy.fktests.api.Test

// Projects use libraries published locally, and other projects straight from their folders. Each
// test has a repository and a cache of its own, as it says what's compiled.

// Fresh projects, in build/test-projects/name: units, a library; money, a library that uses it;
// pricing, which uses money; and shop, a program, which uses pricing from its folder.
@FileSystem libraries(name: String): Path = {
  dir = projects(name)
  write(
    dir,
    "units/build.fk",
    fckt + "project = Project(name = \"units\", group = \"uk.m4xy\", version = \"1.0.0\")\n",
  )
  write(
    dir,
    "units/src/uk/m4xy/units/Cents.fk",
    "module Cents {\n  of(pounds: Int): Int = pounds * 100\n}\n",
  )
  write(
    dir,
    "money/build.fk",
    fckt + "project = Project(\n  name = \"money\",\n  group = \"uk.m4xy\",\n  version = \"2.1.0\",\n  dependencies = [library(\"uk.m4xy:units:1.0.0\")],\n)\n",
  )
  write(
    dir,
    "money/src/uk/m4xy/money/Money.fk",
    "import uk.m4xy.units.Cents\n\nmodule Money {\n  format(pounds: Int): String = \"\${Cents.of(pounds)}p\"\n}\n",
  )
  write(
    dir,
    "pricing/build.fk",
    fckt + "project = Project(name = \"pricing\", dependencies = [library(\"uk.m4xy:money:2.1.0\")])\n",
  )
  write(
    dir,
    "pricing/src/pricing/Prices.fk",
    "import uk.m4xy.money.Money\n\nmodule Prices {\n  label(pounds: Int): String = \"costs \${Money.format(pounds)}\"\n}\n",
  )
  write(
    dir,
    "shop/build.fk",
    fckt + "project = Project(name = \"shop\", dependencies = [projectAt(\"../pricing\")])\n",
  )
  write(
    dir,
    "shop/src/main.fk",
    "import fckt.io.Console\nimport pricing.Prices\nmain() = println(Prices.label(3))\n",
  )
  dir
}

// units and money, published to home's repository.
@FileSystem @Process published(home: Path, dir: Path): Unit = {
  assertEquals(0, kilnIn(home, dir.resolve("units"), ["publishLocal"]).code)
  assertEquals(0, kilnIn(home, dir.resolve("money"), ["publishLocal"]).code)
}

@Test @FileSystem @Process aLibraryIsPublishedAndUsed() = {
  dir = libraries("published")
  home = own("published")
  units = dir.resolve("units")
  money = dir.resolve("money")
  // Nothing's published yet.
  expectContains(
    kilnIn(home, dir.resolve("shop"), ["run"]).value,
    "there's no uk.m4xy:money:2.1.0 in",
  )
  // A library is compiled, checked and copied: only what's under its group.
  expectContains(
    kilnIn(home, units, ["publishLocal"]).value,
    "> Task :check\n> Task :publishLocal\n  published uk.m4xy:units:1.0.0",
  )
  assertEquals(0, kilnIn(home, money, ["publishLocal"]).code)
  // publishLocal compiled it, so it's up to date.
  expectContains(kilnIn(home, money, ["compile"]).value, "> Task :compile\n  up to date\n")
  repository = home.resolve("repository")
  assertEquals(
    "uk.m4xy:units:1.0.0\n",
    repository.resolve("uk.m4xy/money/2.1.0/dependencies").readText(),
  )
  assert(repository.resolve("uk.m4xy/money/2.1.0/src/uk/m4xy/money/Money.fk").exists())
  // The project from its folder, with the libraries it uses and theirs, each compiled once:
  // money's units was, when money was.
  assertEquals(
    "> Task :compile\n  compiling uk.m4xy:money:2.1.0\n> Task :run\ncosts 300p\nBUILD SUCCESSFUL\n",
    kilnIn(home, dir.resolve("shop"), ["run"]).value,
  )
  assertEquals(
    "> Task :compile\n  up to date\n> Task :run\ncosts 300p\nBUILD SUCCESSFUL\n",
    kilnIn(home, dir.resolve("shop"), ["run"]).value,
  )
  // Where editors find its packages and libraries.
  paths = dir.resolve("shop/.kiln/paths").readLines()
  assertEquals(["source src", "source ../pricing/src"], paths.filter { it.startsWith("source ") })
  // The standard library's interface, and units' and money's.
  assertEquals(3, paths.filter { it.startsWith("library ") && it.endsWith("/interface") }.size)
}

// Published again, it's compiled again.
@Test @FileSystem @Process aLibraryPublishedAgainIsCompiledAgain() = {
  dir = libraries("again")
  home = own("again")
  published(home, dir)
  assertEquals(0, kilnIn(home, dir.resolve("shop"), ["run"]).code)
  write(
    dir,
    "units/src/uk/m4xy/units/Cents.fk",
    "module Cents {\n  of(pounds: Int): Int = pounds * 100 + 0\n}\n",
  )
  assertEquals(0, kilnIn(home, dir.resolve("units"), ["publishLocal"]).code)
  expectContains(
    kilnIn(home, dir.resolve("shop"), ["run"]).value,
    "  compiling uk.m4xy:units:1.0.0\n  compiling uk.m4xy:money:2.1.0\n> Task :run\ncosts 300p",
  )
}

// What a library shows says its types, as programs are checked against them without its code; and
// a library that doesn't check, or has packages outside its group, isn't published.
@Test @FileSystem @Process aLibraryThatDoesntCheckIsntPublished() = {
  dir = libraries("unchecked")
  home = own("unchecked")
  money = dir.resolve("money")
  assertEquals(0, kilnIn(home, dir.resolve("units"), ["publishLocal"]).code)
  write(dir, "money/src/uk/m4xy/money/Loose.fk", "module Loose {\n  twice(x: Int) = x * 2\n}\n")
  expectContains(
    kilnIn(home, money, ["compile"]).value,
    "'twice' is in a library's interface, which programs are checked against, so it needs a result type",
  )
  money.resolve("src/uk/m4xy/money/Loose.fk").delete()
  // A library that doesn't check, or has packages outside its group, isn't published.
  write(dir, "money/src/uk/m4xy/money/Broken.fk", "module Broken { f(): Int = \"x\" }\n")
  expectContains(
    kilnIn(home, money, ["publishLocal"]).value,
    "Broken.fk:1:28: error: type mismatch",
  )
  money.resolve("src/uk/m4xy/money/Broken.fk").delete()
  write(dir, "money/src/helpers/Help.fk", "module Help { x(): Int = 1 }\n")
  expectContains(kilnIn(home, money, ["publishLocal"]).value, "package helpers isn't under uk.m4xy")
  money.resolve("src/helpers").delete()
}

// Of two versions asked for, the higher; money's compiled with it.
@Test @FileSystem @Process theHigherOfTwoVersionsIsUsed() = {
  dir = libraries("versions")
  home = own("versions")
  units = dir.resolve("units")
  published(home, dir)
  write(
    dir,
    "units/build.fk",
    fckt + "project = Project(name = \"units\", group = \"uk.m4xy\", version = \"1.10.0\")\n",
  )
  assertEquals(0, kilnIn(home, units, ["publishLocal"]).code)
  write(
    dir,
    "pricing/build.fk",
    fckt + "project = Project(name = \"pricing\", dependencies = [library(\"uk.m4xy:money:2.1.0\"), library(\"uk.m4xy:units:1.10.0\")])\n",
  )
  roots = kilnIn(home, 
    dir.resolve("pricing"),
    ["--quiet", "roots"],
  ).value.lines().filter { it.isNotBlank() }
  assertEquals(
    ["root src", "library uk.m4xy:money:2.1.0", "library uk.m4xy:units:1.10.0", "repository local"],
    roots,
  )
  // money, compiled with units 1.10.0 now.
  write(
    dir,
    "pricing/src/main.fk",
    "import fckt.io.Console\nimport pricing.Prices\nmain() = println(Prices.label(4))\n",
  )
  expectContains(
    kilnIn(home, dir.resolve("pricing"), ["run"]).value,
    "  compiling uk.m4xy:units:1.10.0\n  compiling uk.m4xy:money:2.1.0\n> Task :run\ncosts 400p",
  )
}
