import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Exit
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*

// What the tests share: projects to build, in build/test-projects, and the kiln just built to
// build them with, with a repository and a cache of its own.

// The folder the tests run in, kiln's own.
@Process here(): String = run("pwd", []).value.trim()

// What a build script for a project in fckt starts with: fckt's plugin, applied.
fckt = "import uk.m4xy.kiln.fckt.Fckt\nimport uk.m4xy.kiln.fckt.FcktTasks\n\nplugins = [Fckt()]\n\n"

// A fresh folder for a test's projects.
@FileSystem projects(name: String): Path = {
  folder = path("build/test-projects").resolve(name)
  folder.delete()
  folder.makeDirs()
  folder
}

// Writes text to file, in folder, making the folders it's in.
@FileSystem write(folder: Path, file: String, text: String): Unit = {
  target = folder.resolve(file)
  when (target.parent) {
    Some(parent) -> parent.makeDirs()
    None -> Unit
  }
  target.writeText(text)
}

// Runs the kiln just built in folder: its exit code and everything it printed.
@Process kiln(folder: Path, args: List<String>): Exit<String> = {
  home = here()
  script = "d=\$1; h=\$2; shift 2; cd \"\$d\" && KILN=\"\$h/build/bin/kiln\" KILN_LIB=\"\$h/src\" KILN_REPOSITORY=\"\$h/build/test-repository\" KILN_CACHE=\"\$h/build/test-cache\" exec \"\$h/build/bin/kiln\" \"\$@\""
  exit = run("sh", ["-c", script, "sh", folder.value, home] + args)
  // The standard library is compiled once for all the tests, by whichever runs first.
  Exit(exit.code, exit.value.replace("  compiling the standard library\n", ""))
}

// Fails, saying what was expected and what there was, unless text contains part.
expectContains(
  text: String,
  part: String,
): Unit = if (!text.contains(part)) error("expected to find:\n$part\nin:\n$text")
