import fckt.io.Path
import fckt.io.FileSystem
import fckt.io.Process
import fckt.io.Exit
import fckt.io.Paths.*
import fckt.io.Files.*
import fckt.io.Processes.*

// What the tests share: projects to build, in build/test-projects, and the kiln just built to
// build them with, with a repository and a cache of its own.

// The folder the tests run in, kiln's own.
@Process here(): String = run("pwd", []).value.trim()

// What a build script for a project in fckt starts with: fckt's plugin, applied.
fckt = "import uk.m4xy.kiln.fckt.Fckt\nimport uk.m4xy.kiln.fckt.FcktTasks\n\nplugins = [Fckt()]\n\n"

// A fresh folder for a test's projects.
@FileSystem projects(name: String): Path = {
  folder = path("build/test-projects").resolve(name)
  folder.delete()
  folder.makeDirs()
  folder
}

// Writes text to file, in folder, making the folders it's in.
@FileSystem write(folder: Path, file: String, text: String): Unit = {
  target = folder.resolve(file)
  when (target.parent) {
    Some(parent) -> parent.makeDirs()
    None -> Unit
  }
  target.writeText(text)
}

// Runs the kiln just built in folder: its exit code and everything it printed.
@Process kiln(folder: Path, args: List<String>): Exit<String> =
  kilnWith(folder, args, path("build/test-repository"), path("build/test-cache"))

// A repository and a cache of the test's own, under build/test-own/name, fresh: what a test that
// publishes and compiles libraries, and says what was compiled, runs kilnIn with, so tests run
// together don't share them. What every test compiles alike, the core, the standard library and
// kiln's library for scripts, is compiled once, in the cache the tests share, and linked into it.
@FileSystem @Process own(name: String): Path = {
  folder = path("build/test-own").resolve(name)
  folder.delete()
  folder.makeDirs()
  warm = projects("warm/$name")
  write(warm, "build.fk", fckt + "project = Project(name = \"warm\")\n")
  assertEquals(0, kiln(warm, ["--quiet", "roots"]).code)
  linked = "h=\$1; for t in build/test-cache/*/; do t=\${t%/}; n=\"\$h/cache/\${t##*/}\"; mkdir -p \"\$n\"; for e in \"\$t\"/core \"\$t\"/std-* \"\$t\"/kiln-*; do if [ -e \"\$e/done\" ]; then ln -s \"\$PWD/\$e\" \"\$n/\"; fi; done; done"
  assertEquals(0, run("sh", ["-c", linked, "sh", folder.value]).code)
  folder
}

// Runs the kiln just built in folder, with the repository and cache in home, as own makes it.
@Process kilnIn(home: Path, folder: Path, args: List<String>): Exit<String> =
  kilnWith(folder, args, home.resolve("repository"), home.resolve("cache"))

@Process private kilnWith(
  folder: Path,
  args: List<String>,
  repository: Path,
  cache: Path,
): Exit<String> = {
  home = here()
  script = "d=\$1; h=\$2; r=\$3; c=\$4; shift 4; cd \"\$d\" && unset KILN_LOCK KILN_FETCHED KILN_PUBLISH KILN_QUIET && KILN=\"\$h/build/bin/kiln\" KILN_LIB=\"\$h/src\" KILN_REPOSITORY=\"\$h/\$r\" KILN_CACHE=\"\$h/\$c\" exec \"\$h/build/bin/kiln\" \"\$@\""
  exit = run("sh", ["-c", script, "sh", folder.value, home, repository.value, cache.value] + args)
  // The standard library is compiled once for all the tests, by whichever runs first.
  Exit(exit.code, exit.value.replace("  compiling the standard library\n", ""))
}

// Fails, saying what was expected and what there was, unless text contains part.
expectContains(
  text: String,
  part: String,
): Unit = if (!text.contains(part)) error("expected to find:\n$part\nin:\n$text")
